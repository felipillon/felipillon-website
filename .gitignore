# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── IDE and editors ────────────────────────────────────────────────────────────
.idea/
.vscode/

# ── Dependencies ───────────────────────────────────────────────────────────────
node_modules/
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Environment files — NEVER commit these ─────────────────────────────────────
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
backend/.env
backend/.env.*
*token.json*
*credentials.json*

# ── Felipillon — internal platform files (Emergent) ───────────────────────────
memory/
memory/test_credentials.md
frontend/plugins/
design_guidelines.json
test_result.md
.emergent/
test_reports/

# ── Testing ────────────────────────────────────────────────────────────────────
/coverage

# ── Next.js ────────────────────────────────────────────────────────────────────
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# ── Production builds ──────────────────────────────────────────────────────────
/build
frontend/build/
dist/

# ── Logs and debug files ───────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# ── System files ───────────────────────────────────────────────────────────────
.DS_Store
*.pem
Thumbs.db

# ── Python ─────────────────────────────────────────────────────────────────────
__pycache__/
*pyc*
venv/
.venv/

# ── Development tools ──────────────────────────────────────────────────────────
chainlit.md
.chainlit
.ipynb_checkpoints/
.ac

# ── Deployment ─────────────────────────────────────────────────────────────────
.vercel

# ── Archive files and large assets ────────────────────────────────────────────
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# ── Build caches ───────────────────────────────────────────────────────────────
.cache/

